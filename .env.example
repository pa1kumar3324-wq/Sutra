# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only for staff invitations,
# the bootstrap script and the dev seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dev seed safety: the seed refuses to run unless this is exactly "development"
APP_ENV=development
